# Copy this file to .env and add your own key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Persistent ChromaDB folder (relative to project root by default)
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=enterprise_documents

# Chunk sizes are characters, not tokens.
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=3

# Chroma cosine distance: lower means closer. Tune on a test set.
MAX_COSINE_DISTANCE=0.85
MAX_UPLOAD_MB=15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
